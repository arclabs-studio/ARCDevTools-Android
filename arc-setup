#!/bin/bash
# ARCDevTools-Android Setup Script
# Version: 1.5.0
#
# Installs ARCDevTools-Android configuration files, git hooks, Gradle scaffolding
# (version catalog, build-logic convention plugins, root build files, Gradle wrapper
# version), Claude Code hooks and skills, and generates a Makefile for ARC Labs Studio
# Android projects.

set -e

VERSION="1.5.0"
GRADLE_VERSION="9.8.2"
GRADLE_DISTRIBUTION_SHA256="21bd5da2de49b642904077f38c0efdc7778e92b3ed0889392dca61b97e389607"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(pwd)"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# --- Utility Functions ---

print_info() {
  echo -e "${CYAN}$1${NC}"
}

print_success() {
  echo -e "${GREEN}  $1${NC}"
}

print_error() {
  echo -e "${RED}  $1${NC}"
}

print_warning() {
  echo -e "${YELLOW}  $1${NC}"
}

# --- Parse Arguments ---

WITH_WORKFLOWS=false
NO_WORKFLOWS=false
WITH_GRADLE=false
NO_GRADLE=false
FORCE_GRADLE=false
WITH_MCP=false
NO_MCP=false
VARIANT="Debug"
ALLOW_MISSING_SKILLS=false
SHOW_HELP=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --with-workflows)
      WITH_WORKFLOWS=true
      shift
      ;;
    --no-workflows)
      NO_WORKFLOWS=true
      shift
      ;;
    --with-gradle)
      WITH_GRADLE=true
      shift
      ;;
    --no-gradle)
      NO_GRADLE=true
      shift
      ;;
    --force-gradle)
      WITH_GRADLE=true
      FORCE_GRADLE=true
      shift
      ;;
    --with-mcp)
      WITH_MCP=true
      shift
      ;;
    --no-mcp)
      NO_MCP=true
      shift
      ;;
    --variant)
      VARIANT="${2:-}"
      shift
      if [ $# -gt 0 ]; then
        shift
      fi
      ;;
    --allow-missing-skills)
      ALLOW_MISSING_SKILLS=true
      shift
      ;;
    --help|-h)
      SHOW_HELP=true
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [ "$SHOW_HELP" = true ]; then
  echo ""
  print_info "ARCDevTools-Android Setup v${VERSION}"
  echo ""
  echo "Usage: arc-setup [options]"
  echo ""
  echo "Options:"
  echo "  --with-workflows  Install GitHub Actions workflows (non-interactive)"
  echo "  --no-workflows    Skip GitHub Actions workflows (non-interactive)"
  echo "  --with-gradle     Install Gradle scaffolding (non-interactive): version catalog,"
  echo "                    build-logic, root build files, Gradle wrapper ${GRADLE_VERSION}"
  echo "  --no-gradle       Skip Gradle scaffolding (non-interactive)"
  echo "  --force-gradle    Like --with-gradle, but also overwrite an existing version catalog,"
  echo "                    gradle-daemon-jvm.properties, settings.gradle.kts, build.gradle.kts,"
  echo "                    gradle.properties and .gitignore"
  echo "  --with-mcp        Configure MCP servers for Claude Code (non-interactive)"
  echo "  --no-mcp          Skip MCP server configuration (non-interactive)"
  echo "  --variant <Name>  Android variant for the Makefile's variant tasks (default: Debug)."
  echo "                    Flavored projects pass flavor + build type, e.g. DevDebug"
  echo "                    (test<Name>UnitTest, validate<Name>ScreenshotTest, lint<Name>, ...)"
  echo "  --allow-missing-skills"
  echo "                    Warn instead of failing when the ARCKnowledge-Android skills cannot"
  echo "                    be linked (missing submodule or SKILL.md)"
  echo "  --help, -h        Show this help message"
  echo ""
  echo "Examples:"
  echo "  ./ARCDevTools-Android/arc-setup                                           # Interactive mode"
  echo "  ./ARCDevTools-Android/arc-setup --with-workflows --with-gradle --with-mcp # CI mode, everything"
  echo "  ./ARCDevTools-Android/arc-setup --no-workflows --no-gradle --no-mcp       # Configs and hooks only"
  echo "  ./ARCDevTools-Android/arc-setup --with-gradle --variant DevDebug          # Flavored project (dev flavor)"
  echo ""
  exit 0
fi

# --- Validate Arguments ---

if [[ ! "$VARIANT" =~ ^[A-Z][A-Za-z0-9]*$ ]]; then
  print_error "Invalid --variant '${VARIANT}': expected an alphanumeric name starting with an uppercase letter (e.g. Debug, DevDebug)"
  exit 1
fi

# --- Banner ---

echo ""
print_info "ARCDevTools-Android Setup v${VERSION}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# --- Detect Android Project ---

print_info "Detecting project type..."

HAS_GRADLEW=false
HAS_BUILD_GRADLE=false

if [ -f "$PROJECT_ROOT/gradlew" ]; then
  HAS_GRADLEW=true
fi

if [ -f "$PROJECT_ROOT/build.gradle.kts" ] || [ -f "$PROJECT_ROOT/build.gradle" ]; then
  HAS_BUILD_GRADLE=true
fi

if [ "$HAS_GRADLEW" = false ] && [ "$HAS_BUILD_GRADLE" = false ]; then
  print_error "No gradlew or build.gradle.kts detected"
  print_error "Run this script from your Android project root directory"
  exit 1
fi

print_success "Android project detected"

# --- Copy .editorconfig ---

echo ""
print_info "Copying configurations..."

EDITORCONFIG_SOURCE="$SCRIPT_DIR/configs/.editorconfig"
if [ -f "$EDITORCONFIG_SOURCE" ]; then
  cp "$EDITORCONFIG_SOURCE" "$PROJECT_ROOT/.editorconfig"
  print_success ".editorconfig copied to project root"
else
  print_warning ".editorconfig not found in ARCDevTools-Android"
fi

# --- Copy detekt configs ---

DETEKT_CONFIG_DIR="$PROJECT_ROOT/config/detekt"
mkdir -p "$DETEKT_CONFIG_DIR"

DETEKT_SOURCE="$SCRIPT_DIR/configs/detekt.yml"
if [ -f "$DETEKT_SOURCE" ]; then
  cp "$DETEKT_SOURCE" "$DETEKT_CONFIG_DIR/detekt.yml"
  print_success "detekt.yml copied to config/detekt/"
else
  print_warning "detekt.yml not found in ARCDevTools-Android"
fi

DETEKT_COMPOSE_SOURCE="$SCRIPT_DIR/configs/detekt-compose.yml"
if [ -f "$DETEKT_COMPOSE_SOURCE" ]; then
  cp "$DETEKT_COMPOSE_SOURCE" "$DETEKT_CONFIG_DIR/detekt-compose.yml"
  print_success "detekt-compose.yml copied to config/detekt/"
else
  print_warning "detekt-compose.yml not found in ARCDevTools-Android"
fi

# --- Install Git Hooks ---

echo ""
print_info "Installing git hooks..."

GIT_DIR="$PROJECT_ROOT/.git"
if [ -d "$GIT_DIR" ]; then
  bash "$SCRIPT_DIR/hooks/install-hooks.sh"
else
  print_warning ".git not found (is this a git repository?)"
fi

# --- Gradle Scaffolding ---

# Copies a root template unless the target exists (or --force-gradle was passed).
copy_root_template() {
  local source="$1"
  local target="$2"
  local label="$3"

  if [ ! -f "$source" ]; then
    print_warning "$label template not found in ARCDevTools-Android"
    return
  fi
  if [ -f "$target" ] && [ "$FORCE_GRADLE" = false ]; then
    print_warning "$label exists, kept (use --force-gradle to replace it with the template)"
    return
  fi
  cp "$source" "$target"
  print_success "$label"
}

install_gradle() {
  echo ""
  print_info "Installing Gradle scaffolding..."

  local templates="$SCRIPT_DIR/templates"
  local project_name
  project_name=$(basename "$PROJECT_ROOT")

  # Version catalog
  mkdir -p "$PROJECT_ROOT/gradle"
  copy_root_template "$templates/gradle/libs.versions.toml" \
    "$PROJECT_ROOT/gradle/libs.versions.toml" "gradle/libs.versions.toml"

  # Gradle daemon JVM criteria (JDK 21)
  copy_root_template "$templates/root/gradle-daemon-jvm.properties" \
    "$PROJECT_ROOT/gradle/gradle-daemon-jvm.properties" "gradle/gradle-daemon-jvm.properties"

  # Convention plugins: ARC-managed, always synced (extra files in build-logic/ are kept)
  if [ -d "$templates/build-logic" ]; then
    mkdir -p "$PROJECT_ROOT/build-logic"
    cp -R "$templates/build-logic/." "$PROJECT_ROOT/build-logic/"
    print_success "build-logic/ (arc.* convention plugins)"
  else
    print_warning "templates/build-logic not found in ARCDevTools-Android"
  fi

  # Root build files
  local settings_existed=false
  if [ -f "$PROJECT_ROOT/settings.gradle.kts" ]; then
    settings_existed=true
  fi
  copy_root_template "$templates/root/settings.gradle.kts" \
    "$PROJECT_ROOT/settings.gradle.kts" "settings.gradle.kts"
  if [ "$settings_existed" = false ] || [ "$FORCE_GRADLE" = true ]; then
    sed -i.bak "s/__PROJECT_NAME__/${project_name}/" "$PROJECT_ROOT/settings.gradle.kts"
    rm -f "$PROJECT_ROOT/settings.gradle.kts.bak"
  elif ! grep -q 'includeBuild("build-logic")' "$PROJECT_ROOT/settings.gradle.kts"; then
    print_warning "settings.gradle.kts does not include build-logic: add includeBuild(\"build-logic\") to pluginManagement"
  fi
  copy_root_template "$templates/root/build.gradle.kts" \
    "$PROJECT_ROOT/build.gradle.kts" "build.gradle.kts"
  copy_root_template "$templates/root/gradle.properties" \
    "$PROJECT_ROOT/gradle.properties" "gradle.properties"
  copy_root_template "$templates/root/gitignore" \
    "$PROJECT_ROOT/.gitignore" ".gitignore"

  # Gradle wrapper version (idempotent)
  local wrapper_properties="$PROJECT_ROOT/gradle/wrapper/gradle-wrapper.properties"
  if [ -f "$wrapper_properties" ]; then
    local distribution_url="https\\\\://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
    sed -i.bak \
      -e "s|^distributionUrl=.*|distributionUrl=${distribution_url}|" \
      -e "/^distributionSha256Sum=/d" \
      "$wrapper_properties"
    rm -f "$wrapper_properties.bak"
    echo "distributionSha256Sum=${GRADLE_DISTRIBUTION_SHA256}" >> "$wrapper_properties"
    print_success "Gradle wrapper -> ${GRADLE_VERSION} (run ./gradlew wrapper once to refresh gradle-wrapper.jar)"
  else
    print_warning "gradle/wrapper/gradle-wrapper.properties not found: generate the wrapper with Gradle ${GRADLE_VERSION}"
  fi
}

if [ "$WITH_GRADLE" = true ]; then
  install_gradle
elif [ "$NO_GRADLE" = false ]; then
  echo ""
  read -p "Do you want to install the Gradle scaffolding (catalog, build-logic, root files)? [y/N]: " response
  case "$response" in
    [yY]|[yY][eE][sS])
      install_gradle
      ;;
  esac
fi

# --- Install Claude Code Hooks ---

echo ""
print_info "Installing Claude Code hooks..."

CLAUDE_HOOKS_SOURCE="$SCRIPT_DIR/claude-hooks"
CLAUDE_HOOKS_TARGET="$PROJECT_ROOT/claude-hooks"

if [ -d "$CLAUDE_HOOKS_SOURCE" ]; then
  mkdir -p "$CLAUDE_HOOKS_TARGET"
  for hook_script in "$CLAUDE_HOOKS_SOURCE"/*.sh; do
    if [ -f "$hook_script" ]; then
      FILENAME=$(basename "$hook_script")
      cp "$hook_script" "$CLAUDE_HOOKS_TARGET/$FILENAME"
      chmod +x "$CLAUDE_HOOKS_TARGET/$FILENAME"
      print_success "$FILENAME"
    fi
  done
else
  print_warning "claude-hooks/ not found in ARCDevTools-Android"
fi

# --- Copy Claude Settings ---

CLAUDE_DIR="$PROJECT_ROOT/.claude"
mkdir -p "$CLAUDE_DIR"

CLAUDE_SETTINGS_SOURCE="$SCRIPT_DIR/.claude/settings.json"
if [ -f "$CLAUDE_SETTINGS_SOURCE" ]; then
  if [ ! -f "$CLAUDE_DIR/settings.json" ]; then
    cp "$CLAUDE_SETTINGS_SOURCE" "$CLAUDE_DIR/settings.json"
    print_success "Claude settings.json installed"
  else
    print_warning "Claude settings.json already exists (skipped)"
  fi
fi

# --- Setup Skills ---

echo ""
print_info "Setting up Claude Code skills..."

SETUP_SKILLS="$SCRIPT_DIR/scripts/setup-skills.sh"
SETUP_SKILLS_ARGS=()
if [ "$ALLOW_MISSING_SKILLS" = true ]; then
  SETUP_SKILLS_ARGS+=(--allow-missing-skills)
fi
if [ -f "$SETUP_SKILLS" ]; then
  if ! bash "$SETUP_SKILLS" "${SETUP_SKILLS_ARGS[@]}"; then
    print_error "Claude Code skills setup failed (see above)"
    print_error "Initialise the submodules (git -C ${SCRIPT_DIR##*/} submodule update --init --recursive)"
    print_error "or re-run with --allow-missing-skills to continue without them"
    exit 1
  fi
elif [ "$ALLOW_MISSING_SKILLS" = true ]; then
  print_warning "scripts/setup-skills.sh not found in ARCDevTools-Android (skills not linked)"
else
  print_error "scripts/setup-skills.sh not found in ARCDevTools-Android"
  exit 1
fi

# The skill links are generated per machine: keep them out of git (idempotent).
GITIGNORE="$PROJECT_ROOT/.gitignore"
SKILL_IGNORE_PATTERNS=(".claude/skills/android-*" ".claude/skills/arc-*")
MISSING_IGNORE_PATTERNS=()
for pattern in "${SKILL_IGNORE_PATTERNS[@]}"; do
  if [ ! -f "$GITIGNORE" ] || ! grep -qxF "$pattern" "$GITIGNORE"; then
    MISSING_IGNORE_PATTERNS+=("$pattern")
  fi
done
if [ ${#MISSING_IGNORE_PATTERNS[@]} -gt 0 ]; then
  if [ -s "$GITIGNORE" ] && [ -n "$(tail -c 1 "$GITIGNORE")" ]; then
    echo "" >> "$GITIGNORE"
  fi
  {
    echo ""
    echo "# ARCKnowledge-Android skills (symlinks created by arc-setup)"
    printf '%s\n' "${MISSING_IGNORE_PATTERNS[@]}"
  } >> "$GITIGNORE"
  print_success ".gitignore: added ${MISSING_IGNORE_PATTERNS[*]}"
else
  print_success ".gitignore already ignores the skill links"
fi

# --- Generate Makefile ---

echo ""
print_info "Generating Makefile..."

ARCDEVTOOLS_DIR=$(basename "$SCRIPT_DIR")

cat > "$PROJECT_ROOT/Makefile" << MAKEFILE
# ARCDevTools-Android Makefile
# Auto-generated by arc-setup v${VERSION} - Do not edit manually
# Android variant: ${VARIANT} (change it with: arc-setup --variant <Name>)

.PHONY: help lint format fix test android-lint coverage screenshot screenshot-update setup hooks skills mcp clean

help:
	@echo "ARCDevTools-Android - Available commands:"
	@echo "  make lint              - Run detekt and ktlint"
	@echo "  make format            - Run ktlint format (dry-run)"
	@echo "  make fix               - Apply ktlint format"
	@echo "  make test              - Run unit tests (${VARIANT})"
	@echo "  make android-lint      - Run Android Lint (${VARIANT})"
	@echo "  make coverage          - Run the JaCoCo line-coverage gate (${VARIANT})"
	@echo "  make screenshot        - Validate screenshot tests (${VARIANT})"
	@echo "  make screenshot-update - Record screenshot references (${VARIANT}, intended visual changes only)"
	@echo "  make setup             - Re-install hooks and configs"
	@echo "  make hooks             - Re-install git hooks only"
	@echo "  make skills            - Re-link Claude Code skills"
	@echo "  make mcp               - Configure MCP servers"
	@echo "  make clean             - Clean build artifacts"

lint:
	@./gradlew detekt ktlintCheck --daemon

format:
	@./gradlew ktlintCheck --daemon

fix:
	@./gradlew ktlintFormat --daemon

test:
	@./gradlew test${VARIANT}UnitTest --daemon

android-lint:
	@./gradlew lint${VARIANT} --daemon

coverage:
	@./gradlew jacoco${VARIANT}UnitTestCoverageVerification --daemon

screenshot:
	@./gradlew validate${VARIANT}ScreenshotTest --daemon

screenshot-update:
	@./gradlew update${VARIANT}ScreenshotTest --daemon

setup:
	@./${ARCDEVTOOLS_DIR}/arc-setup --variant ${VARIANT}

hooks:
	@./${ARCDEVTOOLS_DIR}/hooks/install-hooks.sh

skills:
	@./${ARCDEVTOOLS_DIR}/scripts/setup-skills.sh

mcp:
	@./${ARCDEVTOOLS_DIR}/scripts/setup-mcp.sh

clean:
	@./gradlew clean
	@echo "Build artifacts removed"

MAKEFILE

print_success "Makefile generated"

# --- Workflows ---

install_workflows() {
  echo ""
  print_info "Copying GitHub Actions workflows..."

  WORKFLOWS_SOURCE="$SCRIPT_DIR/workflows"
  GITHUB_WORKFLOWS_DIR="$PROJECT_ROOT/.github/workflows"
  mkdir -p "$GITHUB_WORKFLOWS_DIR"

  if [ -d "$WORKFLOWS_SOURCE" ]; then
    for workflow in "$WORKFLOWS_SOURCE"/*.yml; do
      if [ -f "$workflow" ]; then
        FILENAME=$(basename "$workflow")
        cp "$workflow" "$GITHUB_WORKFLOWS_DIR/$FILENAME"
        print_success "$FILENAME"
      fi
    done
  else
    print_warning "workflows/ not found in ARCDevTools-Android"
  fi

  # Copy templates
  TEMPLATES_SOURCE="$SCRIPT_DIR/templates"
  GITHUB_DIR="$PROJECT_ROOT/.github"

  if [ -d "$TEMPLATES_SOURCE" ]; then
    # Copy PR template
    if [ -f "$TEMPLATES_SOURCE/PULL_REQUEST_TEMPLATE.md" ]; then
      cp "$TEMPLATES_SOURCE/PULL_REQUEST_TEMPLATE.md" "$GITHUB_DIR/PULL_REQUEST_TEMPLATE.md"
      print_success "PULL_REQUEST_TEMPLATE.md"
    fi

    # Copy issue templates
    if [ -d "$TEMPLATES_SOURCE/ISSUE_TEMPLATE" ]; then
      mkdir -p "$GITHUB_DIR/ISSUE_TEMPLATE"
      for template in "$TEMPLATES_SOURCE/ISSUE_TEMPLATE"/*.md; do
        if [ -f "$template" ]; then
          FILENAME=$(basename "$template")
          cp "$template" "$GITHUB_DIR/ISSUE_TEMPLATE/$FILENAME"
          print_success "$FILENAME"
        fi
      done
    fi
  fi
}

if [ "$WITH_WORKFLOWS" = true ]; then
  install_workflows
elif [ "$NO_WORKFLOWS" = false ]; then
  echo ""
  read -p "Do you want to copy GitHub Actions workflows? [y/N]: " response
  case "$response" in
    [yY]|[yY][eE][sS])
      install_workflows
      ;;
  esac
fi

# --- MCP Servers ---

if [ "$WITH_MCP" = true ]; then
  bash "$SCRIPT_DIR/scripts/setup-mcp.sh"
elif [ "$NO_MCP" = false ]; then
  echo ""
  read -p "Configure MCP servers for Claude Code? [y/N]: " response
  case "$response" in
    [yY]|[yY][eE][sS])
      bash "$SCRIPT_DIR/scripts/setup-mcp.sh"
      ;;
  esac
fi

# --- Final Summary ---

echo ""
echo -e "${GREEN}ARCDevTools-Android v${VERSION} configured successfully${NC}"
echo ""
echo -e "${BLUE}Installed configurations:${NC}"
echo "   .editorconfig (v${VERSION})"
echo "   config/detekt/detekt.yml (v${VERSION})"
echo "   config/detekt/detekt-compose.yml (v${VERSION})"
echo "   Makefile (v${VERSION}, variant ${VARIANT})"
if [ -d "$PROJECT_ROOT/build-logic" ]; then
  echo "   build-logic/ + gradle/libs.versions.toml (Gradle scaffolding)"
fi
echo ""
echo -e "${BLUE}Claude Code integration:${NC}"
echo "   claude-hooks/ (session-start, validate-commit, block-dangerous-git, format-on-save)"
echo "   .claude/settings.json (hook registrations)"
echo "   .claude/skills/ (symlinked from ARCKnowledge-Android)"
echo ""
echo -e "${BLUE}Next steps:${NC}"
echo "   1. Apply the arc.* plugins in each module (see docs/integration.md)"
echo "   2. Run: ./gradlew build"
echo "   3. Run: make lint && make test"
echo "   4. Make a commit to test pre-commit hook"
echo "   5. Run: make mcp (to configure MCP servers)"
echo ""
echo -e "${BLUE}See available commands: make help${NC}"
echo ""
