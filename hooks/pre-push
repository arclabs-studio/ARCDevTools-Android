#!/bin/bash
# ARCDevTools-Android Pre-push Hook
# Runs unit tests before pushing to remote
# Version: 1.3.0

# Android environment preflight (identical in pre-commit and pre-push: keep them in sync). Git hooks inherit the environment of whatever runs git (an IDE,
# a GUI client, an agent's non-login shell), which often lacks JAVA_HOME / ANDROID_HOME; Gradle
# then fails before any check runs. Find a JDK if needed and stop with an explicit message
# otherwise, instead of reporting the failure as a lint violation.
arc_android_preflight() {
  if [ -z "${JAVA_HOME:-}" ] && ! java -version >/dev/null 2>&1; then
    local jdk_version="21"
    if [ -f "gradle/gradle-daemon-jvm.properties" ]; then
      jdk_version=$(sed -n 's/^toolchainVersion=//p' gradle/gradle-daemon-jvm.properties | head -n 1)
      jdk_version="${jdk_version:-21}"
    fi
    local candidate=""
    if [ -x /usr/libexec/java_home ]; then
      candidate=$(/usr/libexec/java_home -v "$jdk_version" 2>/dev/null || true)
    fi
    if [ -z "$candidate" ]; then
      # JDKs provisioned by Gradle from gradle-daemon-jvm.properties (foojay), e.g.
      # ~/.gradle/jdks/eclipse_adoptium-21-aarch64-os_x.2/jdk-21.0.12.1+1/Contents/Home
      local jdk
      for jdk in "$HOME"/.gradle/jdks/*-"$jdk_version"-*/*/; do
        if [ -x "${jdk}Contents/Home/bin/java" ]; then
          candidate="${jdk}Contents/Home"
        elif [ -x "${jdk}bin/java" ]; then
          candidate="${jdk%/}"
        fi
        if [ -n "$candidate" ]; then
          break
        fi
      done
    fi
    if [ -z "$candidate" ]; then
      echo ""
      echo "========================================================"
      echo "  No JDK found (JAVA_HOME is not set, no java on PATH)"
      echo "========================================================"
      echo ""
      echo "  Export JAVA_HOME (JDK ${jdk_version}) in the environment that runs git,"
      echo "  e.g. export JAVA_HOME=\$(/usr/libexec/java_home -v ${jdk_version})"
      echo ""
      return 1
    fi
    export JAVA_HOME="$candidate"
    echo "  JAVA_HOME not set, using $JAVA_HOME"
  fi

  if [ -z "${ANDROID_HOME:-}" ] && [ -z "${ANDROID_SDK_ROOT:-}" ] \
    && ! grep -qs '^sdk\.dir=' local.properties; then
    echo ""
    echo "========================================================"
    echo "  Android SDK not found"
    echo "========================================================"
    echo ""
    echo "  ANDROID_HOME is not set and local.properties has no sdk.dir."
    echo "  Export ANDROID_HOME in the environment that runs git"
    echo "  (e.g. export ANDROID_HOME=\$HOME/Library/Android/sdk on macOS)."
    echo ""
    return 1
  fi
}

echo "Pre-push: Running unit tests..."

if [ -f "./gradlew" ]; then
  if ! arc_android_preflight; then
    echo "Push aborted. Use --no-verify to bypass (not recommended)"
    exit 1
  fi

  if [ -f "./Makefile" ] && grep -q '^test:' "./Makefile"; then
    # The Makefile generated by arc-setup carries the project's variant (arc-setup --variant),
    # so flavored projects run e.g. testDevDebugUnitTest instead of the ambiguous testDebugUnitTest.
    make test
  else
    ./gradlew testDebugUnitTest --daemon
  fi

  TEST_EXIT_CODE=$?

  if [ $TEST_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "Tests failed. Push aborted."
    echo "Fix failing tests or use --no-verify to bypass (not recommended)"
    exit 1
  fi

  echo "All tests passed. Proceeding with push."
else
  echo "Warning: gradlew not found, skipping tests"
fi

exit 0
